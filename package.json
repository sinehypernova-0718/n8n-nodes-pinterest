{
	"name": "@sinehypernova-0718/n8n-nodes-pinterest",
	"version": "0.1.0",
	"packageManager": "pnpm@12.4.2",
	"description": "Pinterest integration for n8n. Integrate Pinterest with n8n to automate API workflows, manage content, access analytics, and more.",
	"license": "MIT",
	"homepage": "https://github.com/sinehypernova-0718/n8n-nodes-pinterest#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n-nodes-pinterest",
		"n8n-nodes",
		"pinterest",
		"automation",
		"workflow",
		"marketing",
		"social media"
	],
	"author": {
		"name": "Srinjoy",
		"email": "srinjoy875@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sinehypernova-0718/n8n-nodes-pinterest.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "pnpm build && node --test test/",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PinterestOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Pinterest/Pinterest.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
